	$(CC) -DOMC_DLL_MAIN_DEFINE -o $(MAINOBJ) -c $(MAINFILE) $(DIREXTRA)  "-LC:/Program Files/OpenModelica1.27.0-64bit/bin/" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib//omc" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib/" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/binaries/Modelica" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/mingw64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/ucrt64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/win64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library" -lModelicaExternalC -lModelicaStandardTables -lModelicaIO -lModelicaMatIO -lzlib $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
	$(CC) -shared -I. -o logic3_raw$(DLLEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)  "-LC:/Program Files/OpenModelica1.27.0-64bit/bin/" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib//omc" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib/" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/binaries/Modelica" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/mingw64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/ucrt64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/win64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library" -lModelicaExternalC -lModelicaStandardTables -lModelicaIO -lModelicaMatIO -lzlib $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

