.PHONY: $(CFILES)

omc_main_target: $(MAINOBJ) logic3_raw_functions.h logic3_raw_literals.h $(OFILES)
	$(CC) -I. -o logic3_raw$(EXEEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)  "-LC:/Program Files/OpenModelica1.27.0-64bit/bin/" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib//omc" "-LC:/Program Files/OpenModelica1.27.0-64bit/lib/" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/binaries/Modelica" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/mingw64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/ucrt64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library/win64" "-LC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Modelica 3.2.3+maint.om/Resources/Library" -lModelicaExternalC -lModelicaStandardTables -lModelicaIO -lModelicaMatIO -lzlib $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

