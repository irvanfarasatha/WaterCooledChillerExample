# Makefile generated by OpenModelica
# Platform: win64

# Simulations use -O3 by default
CC=clang
CXX=clang++
LINK=clang++ -shared -Xlinker --export-all-symbols
EXEEXT=.exe
DLLEXT=.dll
CFLAGS_BASED_ON_INIT_FILE=
# define OMC_CFLAGS_OPTIMIZATION env variable to your desired optimization level to override this
OMC_CFLAGS_OPTIMIZATION=-Os
DEBUG_FLAGS=$(OMC_CFLAGS_OPTIMIZATION)
CFLAGS=-municode $(CFLAGS_BASED_ON_INIT_FILE) $(DEBUG_FLAGS) -DOM_HAVE_PTHREADS -Wno-parentheses-equality -falign-functions -mstackrealign -msse2 -mfpmath=sse ${MODELICAUSERCFLAGS}   
CPPFLAGS="-IC:/Users/irfan/AppData/Roaming/.openmodelica/libraries/Buildings 6.0.0/Resources/C-Sources" -I"C:/Program Files/OpenModelica1.27.0-64bit/include/omc/c" -I"C:/Program Files/OpenModelica1.27.0-64bit/include/omc" -I. -DOPENMODELICA_XML_FROM_FILE_AT_RUNTIME -DOMC_MODEL_PREFIX=logic3_raw -DOMC_NUM_MIXED_SYSTEMS=0 -DOMC_NUM_LINEAR_SYSTEMS=3 -DOMC_NUM_NONLINEAR_SYSTEMS=28 -DOMC_NDELAY_EXPRESSIONS=0 -DOMC_NVAR_STRING=0
# define OMC_LDFLAGS_LINK_TYPE env variable to "static" to override this
OMC_LDFLAGS_LINK_TYPE=dynamic
RUNTIME_LIBS=-lSimulationRuntimeC -Wl,-Bdynamic -lomcgc -lryu -lopenblas -Wl,-B$(OMC_LDFLAGS_LINK_TYPE)  -lstdc++ -Wl,-Bdynamic 
LDFLAGS=-L"C:/Program Files/OpenModelica1.27.0-64bit/lib//omc" -L"C:/Program Files/OpenModelica1.27.0-64bit/lib" -Wl,--stack,16777216,-rpath,"C:/Program Files/OpenModelica1.27.0-64bit/lib//omc" -L"C:/Program Files/OpenModelica1.27.0-64bit/bin" -Wl,-rpath,"C:/Program Files/OpenModelica1.27.0-64bit/lib"  -fopenmp -Wl,-Bstatic -lregex -ltre -lintl -liconv -lexpat -lpthread -loleaut32 -limagehlp -lhdf5 -lz -lsz -Wl,-Bdynamic $(RUNTIME_LIBS) 
DIREXTRA=-L"C:/Users/irfan/OneDrive/Documents/GitHub/PB/WaterCooledChillerExample/Trial_Final"
MAINFILE=logic3_raw.c
MAINOBJ=logic3_raw.o
CFILES=logic3_raw_functions.c logic3_raw_records.c \
logic3_raw_01exo.c logic3_raw_02nls.c logic3_raw_03lsy.c logic3_raw_04set.c logic3_raw_05evt.c logic3_raw_06inz.c logic3_raw_07dly.c \
logic3_raw_08bnd.c logic3_raw_09alg.c logic3_raw_10asr.c logic3_raw_11mix.c logic3_raw_12jac.c logic3_raw_13opt.c logic3_raw_14lnz.c \
logic3_raw_15syn.c logic3_raw_16dae.c logic3_raw_17inl.c logic3_raw_18spd.c \
