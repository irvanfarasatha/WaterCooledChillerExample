loadModel(Modelica, {"3.2.2"}, false, "", true);
loadModel(Buildings, {"6.0.0"}, false, "", true);
loadFile("package.mo");
simulate(
  WaterCooledChillerExample.WaterCooledChillerExample7,
  startTime = 13046400,
  stopTime = 13651200,
  numberOfIntervals = 1000,
  tolerance = 1e-6,
  method = "dassl",
  outputFormat = "csv",
  fileNamePrefix = "outputs/WaterCooledChillerExample7");
getErrorString();
